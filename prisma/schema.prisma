datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  AGENT
  SUPERVISOR
  CLIENT_ADMIN
  CLIENT_USER
  SYSTEM_ADMIN
}

enum TicketStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  WAITING_CUSTOMER
  WAITING_INTERNAL
  ESCALATED
  RESOLVED
  CLOSED
  REOPENED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ConversationChannel {
  CALL
  CHAT
  EMAIL
  SOCIAL
}

enum QAReviewStatus {
  PENDING
  PASSED
  FLAGGED
  ESCALATED
}

model ClientCompany {
  id          String   @id @default(uuid())
  name        String
  domain      String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  users       CompanyUser[]
  customers   Customer[]
  tickets     Ticket[]
  qaRubrics   QARubric[]
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  name          String?
  role          Role      @default(AGENT)
  passwordHash  String?
  avatarUrl     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  companies     CompanyUser[]
  assignedTickets Ticket[] @relation("AssignedAgent")
  qaReviews     QAReview[]   @relation("Reviewer")
  qaScores      QAReview[]   @relation("AgentReviewed")
}

model CompanyUser {
  id          String        @id @default(uuid())
  userId      String
  companyId   String
  role        Role          @default(AGENT)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  company     ClientCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())

  @@unique([userId, companyId])
}

model Customer {
  id          String        @id @default(uuid())
  tenantId    String
  company     ClientCompany @relation(fields: [tenantId], references: [id])
  name        String
  email       String
  phone       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  tickets     Ticket[]

  @@index([tenantId, email])
}

model Ticket {
  id          String         @id @default(uuid())
  tenantId    String
  company     ClientCompany  @relation(fields: [tenantId], references: [id])
  customerId  String
  customer    Customer       @relation(fields: [customerId], references: [id])
  agentId     String?
  assignedTo  User?          @relation("AssignedAgent", fields: [agentId], references: [id])
  subject     String
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  channel     ConversationChannel @default(EMAIL)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?

  comments    TicketComment[]
  qaReviews   QAReview[]

  @@index([tenantId, status])
  @@index([tenantId, agentId])
}

model TicketComment {
  id        String   @id @default(uuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String
  body      String
  isInternal Boolean @default(false)
  createdAt DateTime @default(now())
}

model QARubric {
  id          String        @id @default(uuid())
  tenantId    String
  company     ClientCompany @relation(fields: [tenantId], references: [id])
  name        String
  criteria    Json
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model QAReview {
  id          String        @id @default(uuid())
  tenantId    String
  ticketId    String
  ticket      Ticket        @relation(fields: [ticketId], references: [id])
  reviewerId  String
  reviewer    User          @relation("Reviewer", fields: [reviewerId], references: [id])
  agentId     String
  agent       User          @relation("AgentReviewed", fields: [agentId], references: [id])
  status      QAReviewStatus @default(PENDING)
  score       Float
  feedback    String?
  createdAt   DateTime      @default(now())
}
